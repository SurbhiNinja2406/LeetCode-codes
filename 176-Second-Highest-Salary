import pandas as pd
def second_highest_salary(employee: pd.DataFrame) -> pd.DataFrame:
    distinct_salaries = employee['salary'].drop_duplicates().sort_values(ascending=False)
    if len(distinct_salaries) >= 2:
        second_value = distinct_salaries.iloc[1]
    else:
        second_value = None
    return pd.DataFrame({'SecondHighestSalary': [second_value]})
if __name__ == "__main__":
    employee1 = pd.DataFrame({
        'id': [1, 2, 3],
        'salary': [100, 200, 300],
    })
    result1 = second_highest_salary(employee1)
    print("Example 1")
    print(employee1)
    print("Output:")
    print(result1)
    expected1 = pd.DataFrame({'SecondHighestSalary': [200]})
    print("PASS" if result1.equals(expected1) else "FAIL")
    print()
    employee2 = pd.DataFrame({
        'id': [1],
        'salary': [100],
    })
    result2 = second_highest_salary(employee2)
    print("Example 2")
    print(employee2)
    print("Output:")
    print(result2)
    expected2 = pd.DataFrame({'SecondHighestSalary': [None]})
    print("PASS" if result2.equals(expected2) else "FAIL")
    print()
    employee3 = pd.DataFrame({
        'id': [1, 2, 3, 4],
        'salary': [300, 300, 200, 100],
    })
    result3 = second_highest_salary(employee3)
    print("Duplicate top salary check:")
    print(result3, "(expect 200, since 300 appears twice but counts once as distinct)")
    print()
    employee4 = pd.DataFrame({
        'id': [1, 2, 3],
        'salary': [50, 50, 50],
    })
    result4 = second_highest_salary(employee4)
    print("All-identical-salary check:")
    print(result4, "(expect null)")
    print()
    employee5 = pd.DataFrame({'id': [], 'salary': []})
    result5 = second_highest_salary(employee5)
    print("Empty table check:")
    print(result5, "(expect null)")
